# ============================================================================
# Ganimation Studio - Frontend Service
# Streamlit UI connecting to API
# ============================================================================

FROM python:3.11-slim

LABEL maintainer="Ganimation Studio"
LABEL service="frontend"

# Environment
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PIP_NO_CACHE_DIR=1

# Streamlit specific
ENV STREAMLIT_SERVER_PORT=8501
ENV STREAMLIT_SERVER_ADDRESS=0.0.0.0
ENV STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
ENV STREAMLIT_THEME_BASE=dark

ARG HOST_UID=1000
ARG HOST_GID=1000

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Create user and directories
RUN set -eux; \
    if ! getent group "${HOST_GID}" >/dev/null; then groupadd -g "${HOST_GID}" ganimation; fi; \
    if ! id -u ganimation >/dev/null 2>&1; then useradd -m -s /bin/bash -u "${HOST_UID}" -g "${HOST_GID}" ganimation; fi; \
    mkdir -p /app \
    && chown -R "${HOST_UID}:${HOST_GID}" /app

WORKDIR /app

# Install Python dependencies
COPY requirements-frontend.txt ./
RUN pip install --upgrade pip && pip install -r requirements-frontend.txt

# Copy application code
COPY app.py config.py ./
COPY views/ ./views/
COPY utils/ ./utils/

# Streamlit config
RUN mkdir -p /home/ganimation/.streamlit
COPY docker/streamlit_config.toml /home/ganimation/.streamlit/config.toml
RUN chown -R "${HOST_UID}:${HOST_GID}" /home/ganimation/.streamlit

# Switch to non-root user
USER ganimation

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

# Expose Streamlit port
EXPOSE 8501

# Run Streamlit
CMD ["streamlit", "run", "app.py"]

