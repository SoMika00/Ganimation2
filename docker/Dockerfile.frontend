# ============================================================================
# Ganimation Studio - Frontend Service
# Streamlit UI connecting to API
# ============================================================================

FROM python:3.11-slim

LABEL maintainer="Ganimation Studio"
LABEL service="frontend"

# Environment
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PIP_NO_CACHE_DIR=1

# Streamlit specific
ENV STREAMLIT_SERVER_PORT=8501
ENV STREAMLIT_SERVER_ADDRESS=0.0.0.0
ENV STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
ENV STREAMLIT_THEME_BASE=dark

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Create user and directories
RUN useradd -m -s /bin/bash ganimation \
    && mkdir -p /app \
    && chown -R ganimation:ganimation /app

WORKDIR /app

# Install Python dependencies
COPY requirements-frontend.txt ./
RUN pip install --upgrade pip && pip install -r requirements-frontend.txt

# Copy application code
COPY app.py config.py ./
COPY pages/ ./pages/
COPY utils/video_processor.py ./utils/

# Streamlit config
RUN mkdir -p /home/ganimation/.streamlit
COPY docker/streamlit_config.toml /home/ganimation/.streamlit/config.toml
RUN chown -R ganimation:ganimation /home/ganimation/.streamlit

# Switch to non-root user
USER ganimation

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

# Expose Streamlit port
EXPOSE 8501

# Run Streamlit
CMD ["streamlit", "run", "app.py"]

